{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Api": {
    "MaxStories": 500,
    "ColdStartRetryAfter": "00:00:10"
  },
  "HackerNews": {
    "BaseAddress": "https://hacker-news.firebaseio.com/v0/",
    "BestStoriesPath": "beststories.json",
    "ItemPathTemplate": "item/{id}.json",
    "DiscussionUrlTemplate": "https://news.ycombinator.com/item?id={id}",
    "RefreshInterval": "00:01:00",
    "FailureRetryDelay": "00:00:10",
    "RequestTimeout": "00:00:10",
    "RefreshTimeout": "00:00:45",
    "MaxConcurrentRequests": 8
  },
  "Cache": {
    "Provider": "Memory",
    "SnapshotKey": "hacker-news:best-stories"
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  }
}
