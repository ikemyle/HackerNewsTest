@implements IDisposable
@inject TimeProvider TimeProvider

<div class="mb-4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-1">
        <MudText Typo="Typo.body2">Cache refresh in @_remainingSeconds s</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@_remainingSeconds / @IntervalSeconds</MudText>
    </MudStack>
    <MudProgressLinear Value="_remainingSeconds"
                       Min="0"
                       Max="IntervalSeconds"
                       Color="Color.Primary"
                       Rounded="true"
                       Size="Size.Medium" />
</div>

@code {
    private PeriodicTimer? _timer;
    private int _remainingSeconds;
    private bool _stale;
    private DateTimeOffset _nextPoll;

    // When the snapshot being shown was published, measured on this client's clock.
    [Parameter, EditorRequired]
    public DateTimeOffset SnapshotTime { get; set; }

    [Parameter, EditorRequired]
    public int IntervalSeconds { get; set; }

    [Parameter, EditorRequired]
    public int PollSeconds { get; set; }

    // When false the countdown still cycles with the server, but never reloads anything.
    [Parameter]
    public bool AutoReload { get; set; }

    // Raised (only with AutoReload) when the countdown passes zero, and every PollSeconds after that
    // until SnapshotTime moves into the current cycle.
    [Parameter]
    public EventCallback Elapsed { get; set; }

    protected override void OnInitialized()
    {
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(1), TimeProvider);
        _ = RunAsync(_timer);
    }

    protected override void OnParametersSet() => Update();

    private async Task RunAsync(PeriodicTimer timer)
    {
        // Disposing the timer makes WaitForNextTickAsync return false, which ends the loop.
        while (await timer.WaitForNextTickAsync())
        {
            await InvokeAsync(async () =>
            {
                Update();
                var now = TimeProvider.GetUtcNow();
                if (_stale && AutoReload && now >= _nextPoll)
                {
                    _nextPoll = now.AddSeconds(PollSeconds);
                    await Elapsed.InvokeAsync();
                }
                StateHasChanged();
            });
        }
    }

    // The server refreshes every IntervalSeconds starting from SnapshotTime, so the countdown is the time left
    // in the current cycle: it runs down to zero and wraps back to the full interval without a reload.
    // It is recomputed from the clock on every tick so a delayed tick (a busy browser tab) doesn't make it drift.
    private void Update()
    {
        var interval = TimeSpan.FromSeconds(IntervalSeconds);
        var elapsed = TimeProvider.GetUtcNow() - SnapshotTime;
        if (elapsed < TimeSpan.Zero)
        {
            elapsed = TimeSpan.Zero;
        }

        var completedCycles = (long)(elapsed / interval);
        var remaining = interval - (elapsed - interval * completedCycles);
        _remainingSeconds = (int)Math.Ceiling(remaining.TotalSeconds);

        // Stale means the server should have published a newer snapshot than the one shown.
        var stale = completedCycles > 0;
        if (stale && !_stale)
        {
            // Just passed zero: with auto reload, reload on this tick.
            _nextPoll = DateTimeOffset.MinValue;
        }
        _stale = stale;
    }

    public void Dispose() => _timer?.Dispose();
}
